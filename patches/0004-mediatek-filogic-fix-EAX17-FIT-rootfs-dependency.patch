From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiaming Shi <jiaming.shih@gmail.com>
Date: Wed, 6 May 2026 00:00:00 +0000
Subject: [PATCH] mediatek: filogic: fix EAX17 FIT rootfs dependency

The EAX17 FIT image contains a top-level rootfs node with the rootfs
size and SHA1 hash. After switching this node to use the per-device
rootfs path, the kernel image recipe reads root.squashfs+pkg=<hash>.

However, kernel image targets do not normally depend on rootfs targets.
As a result, selected EAX17 builds can try to hash the per-device rootfs
before it has been generated. In ImageBuilder builds, EAX17 kernel images
may also be built even when the EAX17 profile is not selected; in that
case ROOTFS_ID/netgear_eax17 is empty and the path expands to the invalid
root.squashfs+pkg=.

Use the per-device rootfs suffix only when ROOTFS_ID exists, and add the
same rootfs path as an explicit dependency of the EAX17 kernel target.

Signed-off-by: Jiaming Shi <jiaming.shih@gmail.com>
---
 target/linux/mediatek/image/filogic.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -10,7 +10,7 @@ endef
 
 define Build/fit-with-netgear-top-level-rootfs-node
 	$(call Build/fit-its,$(1))
-	$(TOPDIR)/scripts/gen_netgear_rootfs_node.sh $(KERNEL_BUILD_DIR)/root.squashfs$(if $(TARGET_PER_DEVICE_ROOTFS),+pkg=$(ROOTFS_ID/$(DEVICE_NAME))) > $@.rootfs
+	$(TOPDIR)/scripts/gen_netgear_rootfs_node.sh $(KERNEL_BUILD_DIR)/root.squashfs$(if $(ROOTFS_ID/$(DEVICE_NAME)),+pkg=$(ROOTFS_ID/$(DEVICE_NAME))) > $@.rootfs
 	awk '/configurations/ { system("cat $@.rootfs") } 1' $@.its > $@.its.tmp
 	@mv -f $@.its.tmp $@.its
 	@rm -f $@.rootfs
@@ -2511,6 +2511,7 @@ define Device/netgear_eax17
   NETGEAR_ENC_HW_ID_LIST := 1010000013120000_NETGEAR
   NETGEAR_ENC_MODEL_LIST := EAX17;EAX11v3;EAX15v3;EAX14v3;EAX12v2;EAX16;EAX19
   DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware
+  KERNEL_DEPENDS = $$(KDIR)/root.squashfs$$(if $$(ROOTFS_ID/netgear_eax17),+pkg=$$(ROOTFS_ID/netgear_eax17))
   KERNEL = kernel-bin | lzma | \
 	fit-with-netgear-top-level-rootfs-node lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb
   KERNEL_IN_UBI := 1
